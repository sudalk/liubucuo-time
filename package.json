{
  "name": "lbc",
  "version": "0.1.0",
  "private": true,
  "description": "柳不匆 - 个人活动记录产品",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,magenta \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "vite build",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=esm --outfile=dist/worker/index.mjs --external:cloudflare:workers --external:cloudflare:sockets",
    "preview": "vite preview",
    "deploy": "pnpm build:web && wrangler deploy",
    "android:sync": "pnpm build:web && cap sync android",
    "android:debug": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lbc-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply lbc-db --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.24",
    "@capacitor/android": "7",
    "@capacitor/core": "7",
    "@capacitor/keyboard": "7",
    "@capacitor/preferences": "7",
    "ai": "^4.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "framer-motion": "^11.11.0",
    "hono": "^4.6.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7",
    "@cloudflare/workers-types": "^4.20260629.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.28.0",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.21.0",
    "wrangler": "^4.105.0"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": false
    }
  },
  "packageManager": "pnpm@9.12.0"
}
